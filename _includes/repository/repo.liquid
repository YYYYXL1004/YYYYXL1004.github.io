{% assign repo = include.repository %}
<a class="repository-card" href="https://github.com/{{ repo.repository }}" aria-label="在 GitHub 查看 {{ repo.name }}">
  <div class="repository-card-topline">
    <span class="repository-icon"><i class="fa-brands fa-github"></i></span>
    {% if repo.highlight %}
      <span class="repository-highlight">{{ repo.highlight }}</span>
    {% endif %}
  </div>

  <div class="repository-card-content">
    <h2>{{ repo.name }}</h2>
    <p>{{ repo.description }}</p>
  </div>

  <div class="repository-tags" aria-label="项目标签">
    {% for tag in repo.tags %}
      <span>{{ tag }}</span>
    {% endfor %}
  </div>

  <span class="repository-card-link">
    View on GitHub
    <i class="fa-solid fa-arrow-right"></i>
  </span>
</a>
